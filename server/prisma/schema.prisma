  users                      users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comments                   comments[]
  stock_items                stock_items[]

  @@index([group_id], map: "idx_articles_group_id")
  @@index([visibility], map: "idx_articles_visibility")
  @@schema("knowledge")
}

