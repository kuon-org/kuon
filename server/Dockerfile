FROM node:20

WORKDIR /app

ENV TZ=Asia/Tokyo

# Install only production dependencies from the source package definition.
COPY package*.json ./
RUN npm ci --omit=dev

# Copy the build artifact and runtime assets generated by GitHub Actions.
COPY dist ./dist
COPY public ./public
COPY prisma ./prisma
COPY node_modules/.prisma ./node_modules/.prisma

EXPOSE 9040

CMD ["node", "dist/index.js"]
