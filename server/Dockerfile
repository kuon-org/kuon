FROM node:24

WORKDIR /app

ENV TZ=Asia/Tokyo
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

# pnpm 11 keeps build-script approvals in workspace/project configuration.
# This image installs the server as a standalone production project.
RUN printf '%s\n' \
    'allowBuilds:' \
    '  "@prisma/engines": true' \
    '  "@scarf/scarf": false' \
    '  argon2: true' \
    > pnpm-workspace.yaml

# Install only production dependencies from the server package definition.
COPY package.json ./
RUN pnpm install --prod --no-frozen-lockfile

# Copy the build artifact and runtime assets generated by GitHub Actions.
COPY dist ./dist
COPY public ./public
COPY prisma ./prisma

# Generate Prisma Client inside the runtime image.
# prisma is a development dependency, so use a temporary CLI via pnpm dlx.
RUN pnpm dlx prisma@7.9.1 generate --schema=./prisma/schema.prisma

EXPOSE 9040

CMD ["node", "dist/index.js"]
