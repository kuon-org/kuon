FROM node:24

WORKDIR /app

ENV TZ=Asia/Tokyo
ENV NODE_ENV=production

RUN corepack enable && corepack prepare pnpm@11.21.0 --activate

# Backup export uses pg_dump against PostgreSQL 18.
# Install the matching client from the official PostgreSQL apt repository.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && rm -rf /var/lib/apt/lists/*

# pnpm 11 keeps build-script approvals in workspace/project configuration.
# This image installs the server as a standalone production project.
RUN printf '%s\n' \
    'allowBuilds:' \
    '  "@prisma/engines": true' \
    '  "@scarf/scarf": false' \
    '  argon2: true' \
    > pnpm-workspace.yaml

# Install only production dependencies from the server package definition.
COPY package.json ./
RUN pnpm install --prod --no-frozen-lockfile

# Copy the build artifact and runtime assets generated by GitHub Actions.
COPY dist ./dist
COPY prisma ./prisma
COPY migration ./migration

# Generate Prisma Client inside the runtime image.
# prisma is a development dependency, so use a temporary CLI via pnpm dlx.
RUN pnpm dlx prisma@7.9.1 generate --schema=./prisma/schema.prisma

EXPOSE 9040

CMD ["node", "dist/index.js"]
